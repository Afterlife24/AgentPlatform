# WhatsApp Dashboard Subdomain Configuration
# Serves dashboard at https://adapter.afterlife.org.in

upstream whatsapp_dashboard {
    server whatsapp-dashboard:3001;
}

upstream whatsapp_adapter {
    server whatsapp-adapter:8080;
}

# HTTP redirect to HTTPS
server {
    listen 80;
    server_name adapter.afterlife.org.in;

    location ^~ /.well-known/acme-challenge/ {
        root /etc/nginx/certs;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server for WhatsApp dashboard
server {
    listen 443 ssl;
    server_name adapter.afterlife.org.in;

    ssl_certificate     /etc/nginx/certs/local.crt;
    ssl_certificate_key /etc/nginx/certs/local.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Dashboard UI (Next.js)
    location / {
        proxy_pass http://whatsapp_dashboard;
        proxy_http_version 1.1;

        # WebSocket support for Next.js HMR
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # Timeouts
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # API proxy for backend calls
    # Dashboard calls https://devagents.afterlife.org.in/adapter/* for API
    # So this is just for direct testing
    location /adapter/ {
        proxy_pass http://whatsapp_adapter;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
